{
  "name": "aspa-mcp",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "Local MCP server and background service to read and act on Aspa Chat support conversations from AI assistants.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "aspa",
    "whatsapp",
    "support",
    "puppeteer"
  ],
  "author": "aspa-mcp contributors",
  "bin": {
    "aspa-mcp": "./index.mjs"
  },
  "scripts": {
    "start": "node index.mjs",
    "daemon": "node daemon.mjs",
    "smoke": "node smoke.mjs",
    "install-service": "node install-service.mjs",
    "setup-transcribe": "node setup-transcribe.mjs",
    "test-notify": "node test-notify.mjs",
    "init-config": "node init-config.mjs",
    "auditoria": "node audit-cli.mjs",
    "atualizar": "node update.mjs",
    "slack": "node configure-slack.mjs",
    "test": "node --test test/*.test.mjs",
    "saude": "node health-cli.mjs",
    "doctor": "node doctor-cli.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "puppeteer-core": "25.16.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "license": "MIT"
}
