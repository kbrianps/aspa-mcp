{
  "name": "aspa-mcp",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Local MCP server and daemon to read and act on Aspa Chat support conversations for Claude.",
  "bin": {
    "aspa-mcp": "./index.mjs"
  },
  "scripts": {
    "start": "node index.mjs",
    "daemon": "node daemon.mjs",
    "smoke": "node smoke.mjs",
    "install-service": "node install-service.mjs",
    "setup-transcribe": "node setup-transcribe.mjs",
    "test-notify": "node test-notify.mjs",
    "init-config": "node init-config.mjs",
    "auditoria": "node audit-cli.mjs",
    "atualizar": "node update.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "puppeteer-core": "25.16.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
